        {
          "name": "Request Password Reset Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password/request",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password",
                "request"
              ]
            },
            "description": "Generates a 6-digit password reset code. In development (with debug settings on), the code will print in the backend terminal logs."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
