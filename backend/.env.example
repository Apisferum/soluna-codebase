# JWT_SECRET_KEY=replace-with-a-long-random-secret

# # Optional paths
# # SYNESTRA_DB_PATH=D:/daisy/music_frontend/backend/data/synestra.db
# # GENERATED_FILES_DIR=D:/daisy/music_frontend/backend/generated


APP_NAME=Synestra Unified Backend
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

# Add service-specific settings later.
# JWT_SECRET_KEY=replace-with-a-long-random-secret
# DATABASE_PATH=data/synestra.db

# Composer execution
# Recommended: use Celery so Moonbeam does not load inside the FastAPI process.
COMPOSER_EXECUTION_MODE=celery
REDIS_URL=redis://localhost:6379/0

# Optional: point this at a remote unified composer service (for example a Kaggle/Cloudflare URL).
# When set, it takes priority over local Celery execution.
# COMPOSER_REMOTE_API_URL=https://your-composer-host.example.com
