# Backend API URL - Required for production deployment
# Local development uses the Vite /api proxy to the unified backend on port 8000.
# VITE_API_URL=http://127.0.0.1:8000

# Production (replace with your actual backend URL):
# VITE_API_URL=https://your-backend-url.com

# Note: Create a .env.local file with your actual values
# The .env.local file should NOT be committed to git
# VITE_AUTH_API_URL=http://127.0.0.1:8000
# # Synestra authentication backend
#VITE_AUTH_API_URL=http://127.0.0.1:8000