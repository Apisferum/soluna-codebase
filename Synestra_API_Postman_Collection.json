    {
      "name": "Audio Separation",
      "item": [
        {
          "name": "Separate 2-Stem (Vocals & Instrumental)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.session_id) {",
                  "    pm.collectionVariables.set(\"separation_session_id\", jsonData.session_id);",
                  "    console.log(\"Saved 2-stem session_id to collection variable 'separation_session_id'\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "description": "Choose the audio file to separate",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "format",
                  "value": "wav",
                  "description": "wav or mp3",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/audio/separate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audio",
                "separate"
              ]
            },
            "description": "Uploads and separates an audio file into vocals and instrumental. The resulting session ID is saved automatically."
          },
          "response": []
        },
        {
          "name": "Separate 6-Stem",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.session_id) {",
                  "    pm.collectionVariables.set(\"stems_session_id\", jsonData.session_id);",
                  "    console.log(\"Saved 6-stem session_id to collection variable 'stems_session_id'\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "description": "Choose the audio file to separate into 6 stems",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "format",
                  "value": "wav",
                  "description": "wav or mp3",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/audio/separate-stems",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audio",
                "separate-stems"
              ]
            },
            "description": "Separates the uploaded track into vocals, drums, bass, guitar, piano, and other. Saves the session ID automatically."
          },
          "response": []
        },
        {
          "name": "Download 2-Stem Result",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audio/separate/download/{{separation_session_id}}/vocals?format=wav",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audio",
                "separate",
                "download",
                "{{separation_session_id}}",
                "vocals"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "wav"
                }
              ]
            },
            "description": "Downloads either 'vocals' or 'instrumental' generated by 2-stem separation."
          },
          "response": []
        },
        {
          "name": "Download 6-Stem Result",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audio/separate-stems/download/{{stems_session_id}}/vocals?format=wav",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audio",
                "separate-stems",
                "download",
                "{{stems_session_id}}",
                "vocals"
              ],
              "query": [
                {
                  "key": "format",
                  "value": "wav"
                }
              ]
            },
            "description": "Downloads one of the stems from the 6-stem separation: vocals, drums, bass, guitar, piano, other."
          },
          "response": []
        }
      ],
      "description": "Audio stem separation endpoints powered by Spleeter/Demucs."
    },
    {
      "name": "Audio Analysis (Chord AI)",
      "item": [
        {
          "name": "Analyze Uploaded File",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "description": "Choose the audio file to analyze for chords",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "separate_vocals",
                  "value": "false",
                  "description": "If true, isolates instrumental first (slower, more accurate)",
                  "type": "text"
                },
                {
                  "key": "use_madmom",
                  "value": "true",
                  "description": "If true, uses fast madmom engine",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/audio/analyze",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audio",
                "analyze"
              ]
            },
            "description": "Detects chords in the uploaded audio file."
          },
          "response": []
        },
        {
          "name": "Analyze YouTube Video",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "url",
                  "value": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
                  "description": "YouTube video link to download and analyze",
                  "type": "text"
                },
                {
                  "key": "separate_vocals",
                  "value": "false",
                  "description": "If true, isolates instrumental first (slower, more accurate)",
                  "type": "text"
                },
                {
                  "key": "use_madmom",
                  "value": "true",
                  "description": "If true, uses fast madmom engine",
                  "type": "text"
                },
                {
                  "key": "client_ip",
                  "value": "127.0.0.1",
                  "description": "Client IP for rate limiting checks",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/audio/analyze-youtube",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audio",
                "analyze-youtube"
              ]
            },
            "description": "Downloads a YouTube video as audio and performs chord detection on it."
          },
          "response": []
        },
        {
          "name": "Get YouTube Video Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audio/youtube/info?url=https://www.youtube.com/watch?v=dQw4w9WgXcQ",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audio",
                "youtube",
                "info"
              ],
              "query": [
                {
                  "key": "url",
                  "value": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
                }
              ]
            },
            "description": "Extracts basic video information (title, thumbnail, duration) from a YouTube link without downloading it."
          },
          "response": []
        },
        {
          "name": "Download Instrumental from Analysis",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audio/analyze/download/{{analysis_file_id}}/instrumental.wav",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "audio",
                "analyze",
                "download",
                "{{analysis_file_id}}",
                "instrumental.wav"
              ]
            },
            "description": "If separate_vocals was used during analysis, downloading the instrumental track is enabled."
          },
          "response": []
        }
      ],
      "description": "Chord estimation and YouTube extraction capabilities."
    },
